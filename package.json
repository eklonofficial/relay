{
  "name": "site-build",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node docs/games/blockhaven/tools/build.mjs",
    "build:shockshellers": "node docs/games/shockshellers/tools/build.mjs",
    "build:site": "node docs/games/tools/build.mjs",
    "test": "node --test docs/games/blockhaven/tests/*.test.mjs",
    "test:shockshellers": "node --test docs/games/shockshellers/tests/*.test.mjs",
    "test:calc": "node --test docs/games/tests/*.test.mjs",
    "test:relay": "node --test blockhaven-relay/relay.test.mjs",
    "test:browser": "node docs/games/blockhaven/tools/surface-check.mjs && node docs/games/blockhaven/tools/browser-check.mjs",
    "test:browser:shockshellers": "node docs/games/shockshellers/tools/surface-check.mjs && node docs/games/shockshellers/tools/browser-check.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  }
}

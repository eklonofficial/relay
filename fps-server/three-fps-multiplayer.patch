index 0000000..a98e7f3
--- /dev/null
+++ b/src/net/Network.js
@@ -0,0 +1,333 @@
+import * as THREE from 'three'
+import Component from '../Component'
+import Entity from '../Entity'
+import {Ammo} from '../AmmoLib'
+import { SkeletonUtils } from 'three/examples/jsm/utils/SkeletonUtils'
+import RemotePlayer from '../entities/RemotePlayer/RemotePlayer'
+import CharacterCollision from '../entities/NPC/CharacterCollision'
+
+const SEND_INTERVAL = 0.05;
+// Camera sits 0.5 above the capsule centre, which is 0.95 above the feet.
+const EYE_HEIGHT = 1.45;
+const SPAWN_SEARCH_ORIGIN = new THREE.Vector3(10.8, 0.0, 22.0);
+
+export default class Network extends Component{
+    constructor({url, playerName, scene, physicsWorld, mutant, clips, shotBuffer, listener}){
+        super();
+        this.name = 'Network';
+        this.url = url;
+        this.playerName = playerName;
+        this.scene = scene;
+        this.physicsWorld = physicsWorld;
+        this.mutant = mutant;
+        this.clips = clips;
+        this.shotBuffer = shotBuffer;
+        this.listener = listener;
+
+        this.ws = null;
+        this.id = null;
+        this.remotes = new Map();
+        this.names = new Map();
+        this.scores = new Map();
+        this.sendTimer = 0;
+        this.retryDelay = 1000;
+        this.attempts = 0;
+        this.scoreboardDirty = true;
+    }
+
+    Initialize(){
+        this.entityManager = this.parent.parent;
+        this.controls = this.GetComponent('PlayerControls');
+        this.body = this.GetComponent('PlayerPhysics').body;
+        this.health = this.GetComponent('PlayerHealth');
+        this.uimanager = this.FindEntity('UIManager').GetComponent('UIManager');
+        this.navmesh = this.FindEntity('Level').GetComponent('Navmesh');
+
+        this.parent.RegisterEventHandler(this.OnLocalShot, 'ak47_shot');
+        this.CreateHud();
+        this.TeleportToRandomSpawn();
+        this.Connect();
+    }
+
+    // ---------- connection ----------
+
+    Connect(){
+        this.SetStatus(this.attempts === 0 ? 'Connecting to server…' : 'Waking up the server — free servers can take up to a minute…');
+        let ws;
+        try{
+            ws = new WebSocket(this.url);
+        }catch(e){
+            this.SetStatus('Bad server address in config.js');
+            return;
+        }
+        this.ws = ws;
+
+        ws.onopen = () => {
+            this.attempts = 0;
+            this.retryDelay = 1000;
+            this.Send({t: 'hello', name: this.playerName});
+        };
+
+        ws.onmessage = e => {
+            let msg;
+            try{
+                msg = JSON.parse(e.data);
+            }catch(err){
+                return;
+            }
+            this.Handle(msg);
+        };
+
+        ws.onclose = e => {
+            this.id = null;
+            this.ClearRemotes();
+            if(e.code === 4000){
+                this.SetStatus('Server is full — try again later');
+                return;
+            }
+            this.attempts++;
+            this.SetStatus(this.attempts < 3 ? 'Waking up the server — free servers can take up to a minute…' : 'Can\'t reach the server — retrying…');
+            setTimeout(() => this.Connect(), this.retryDelay);
+            this.retryDelay = Math.min(this.retryDelay * 2, 10000);
+        };
+    }
+
+    Send(msg){
+        if(this.ws && this.ws.readyState === WebSocket.OPEN){
+            this.ws.send(JSON.stringify(msg));
+        }
+    }
+
+    SendHit(targetId){
+        if(this.parent.dead){
+            return;
+        }
+        this.Send({t: 'hit', target: targetId});
+        this.FlashHitmarker();
+    }
+
+    OnLocalShot = () => {
+        this.Send({t: 'shot'});
+    }
+
+    Handle(msg){
+        switch(msg.t){
+            case 'welcome':
+                this.id = msg.id;
+                this.names.set(msg.id, this.playerName);
+                this.scores.set(msg.id, [0, 0]);
+                msg.players.forEach(p => this.AddRemote(p));
+                this.SetStatus('');
+                this.AddFeed('You joined the match');
+                break;
+            case 'join':
+                this.AddRemote(msg.player);
+                this.AddFeed(`${msg.player.name} joined`);
+                break;
+            case 'leave':
+                this.AddFeed(`${this.names.get(msg.id) || 'A player'} left`);
+                this.RemoveRemote(msg.id);
+                break;
+            case 'snap':
+                for(const [id, x, y, z, yaw, anim, dead, kills, deaths] of msg.s){
+                    const prev = this.scores.get(id);
+                    if(!prev || prev[0] !== kills || prev[1] !== deaths){
+                        this.scores.set(id, [kills, deaths]);
+                        this.scoreboardDirty = true;
+                    }
+                    const remote = this.remotes.get(id);
+                    remote && remote.controller.SetTarget(x, y, z, yaw, anim, dead === 1);
+                }
+                break;
+            case 'shot': {
+                const remote = this.remotes.get(msg.id);
+                remote && remote.controller.PlayShot();
+                break;
+            }
+            case 'hp':
+                this.health.health = msg.hp;
+                this.uimanager.SetHealth(msg.hp);
+                this.FlashDamage();
+                break;
+            case 'kill': {
+                const killer = msg.killer === this.id ? 'You' : (this.names.get(msg.killer) || '?');
+                const victim = msg.victim === this.id ? 'you' : (this.names.get(msg.victim) || '?');
+                this.AddFeed(`${killer} eliminated ${victim}`);
+                if(msg.victim === this.id){
+                    this.Die(this.names.get(msg.killer) || 'another player');
+                }
+                break;
+            }
+            case 'respawn':
+                this.Respawn(msg.hp);
+                break;
+        }
+    }
+
+    // ---------- remote players ----------
+
+    AddRemote(info){
+        if(info.id === this.id || this.remotes.has(info.id)){
+            return;
+        }
+        this.names.set(info.id, info.name);
+        this.scores.set(info.id, [info.kills, info.deaths]);
+        this.scoreboardDirty = true;
+
+        const entity = new Entity();
+        entity.SetName(`Remote${info.id}`);
+        entity.SetPosition(new THREE.Vector3(0, -100, 0));
+        const controller = new RemotePlayer({
+            id: info.id,
+            playerName: info.name,
+            model: SkeletonUtils.clone(this.mutant),
+            clips: this.clips,
+            scene: this.scene,
+            shotBuffer: this.shotBuffer,
+            listener: this.listener,
+            network: this,
+        });
+        const collision = new CharacterCollision(this.physicsWorld);
+        entity.AddComponent(controller);
+        entity.AddComponent(collision);
+        this.entityManager.Add(entity);
+        controller.Initialize();
+        collision.Initialize();
+
+        this.remotes.set(info.id, {entity, controller, collision});
+    }
+
+    RemoveRemote(id){
+        const remote = this.remotes.get(id);
+        if(remote){
+            remote.collision.Destroy();
+            remote.controller.Destroy();
+            this.entityManager.Remove(remote.entity);
+            this.remotes.delete(id);
+        }
+        this.names.delete(id);
+        this.scores.delete(id);
+        this.scoreboardDirty = true;
+    }
+
+    ClearRemotes(){
+        [...this.remotes.keys()].forEach(id => this.RemoveRemote(id));
+        this.scores.clear();
+        this.scoreboardDirty = true;
+    }
+
+    // ---------- local player ----------
+
+    TeleportToRandomSpawn(){
+        const node = this.navmesh.GetRandomNode(SPAWN_SEARCH_ORIGIN, 80) || SPAWN_SEARCH_ORIGIN;
+        const transform = new Ammo.btTransform();
+        transform.setIdentity();
+        transform.setOrigin(new Ammo.btVector3(node.x, node.y + 1.0, node.z));
+        this.body.setWorldTransform(transform);
+        this.body.getMotionState().setWorldTransform(transform);
+        this.body.setLinearVelocity(new Ammo.btVector3(0, 0, 0));
+        Ammo.destroy(transform);
+    }
+
+    Die(killerName){
+        this.parent.dead = true;
+        this.deathOverlay.textContent = `Eliminated by ${killerName} — respawning…`;
+        this.deathOverlay.style.display = 'flex';
+    }
+
+    Respawn(hp){
+        this.TeleportToRandomSpawn();
+        this.health.health = hp;
+        this.uimanager.SetHealth(hp);
+        this.parent.dead = false;
+        this.deathOverlay.style.display = 'none';
+    }
+
+    Update(t){
+        if(this.scoreboardDirty){
+            this.RenderScoreboard();
+            this.scoreboardDirty = false;
+        }
+
+        this.sendTimer += t;
+        if(this.id === null || this.sendTimer < SEND_INTERVAL){
+            return;
+        }
+        this.sendTimer = 0;
+
+        const pos = this.parent.Position;
+        const moving = this.controls.speed.length() > 0.5;
+        this.Send({
+            t: 'state',
+            p: [+pos.x.toFixed(2), +(pos.y - EYE_HEIGHT).toFixed(2), +pos.z.toFixed(2)],
+            y: +this.controls.angles.y.toFixed(3),
+            a: moving && !this.parent.dead ? 1 : 0,
+        });
+    }
+
+    // ---------- HUD ----------
+
+    CreateHud(){
+        const make = (css) => {
+            const el = document.createElement('div');
+            el.style.cssText = 'position:absolute;pointer-events:none;font-family:Roboto,Arial,sans-serif;' + css;
+            document.body.appendChild(el);
+            return el;
+        };
+        this.statusEl = make('top:12px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.55);padding:6px 14px;border-radius:6px;font-size:14px;display:none;');
+        this.scoreboardEl = make('top:12px;right:12px;background:rgba(0,0,0,0.45);padding:8px 12px;border-radius:6px;font-size:13px;min-width:150px;');
+        this.feedEl = make('top:12px;left:100px;font-size:13px;line-height:1.6;text-shadow:0 0 3px #000;');
+        this.deathOverlay = make('inset:0;display:none;align-items:center;justify-content:center;background:rgba(120,0,0,0.35);font-size:28px;font-weight:700;text-shadow:0 0 6px #000;');
+        this.damageEl = make('inset:0;box-shadow:inset 0 0 120px rgba(255,0,0,0.8);opacity:0;transition:opacity 0.4s;');
+        this.hitmarkerEl = make('top:50%;left:50%;transform:translate(-50%,-50%);font-size:34px;color:#ff4d4d;opacity:0;transition:opacity 0.15s;');
+        this.hitmarkerEl.textContent = '✕';
+    }
+
+    SetStatus(text){
+        this.statusEl.textContent = text;
+        this.statusEl.style.display = text ? 'block' : 'none';
+    }
+
+    AddFeed(text){
+        const line = document.createElement('div');
+        line.textContent = text;
+        this.feedEl.appendChild(line);
+        while(this.feedEl.childNodes.length > 5){
+            this.feedEl.removeChild(this.feedEl.firstChild);
+        }
+        setTimeout(() => line.remove(), 6000);
+    }
+
+    RenderScoreboard(){
+        const rows = [...this.scores.entries()]
+            .filter(([id]) => this.names.has(id))
+            .sort((a, b) => b[1][0] - a[1][0]);
+        this.scoreboardEl.textContent = '';
+        const title = document.createElement('div');
+        title.style.cssText = 'font-weight:700;margin-bottom:4px;';
+        title.textContent = `Online — ${rows.length} player${rows.length === 1 ? '' : 's'}`;
+        this.scoreboardEl.appendChild(title);
+        rows.forEach(([id, [kills, deaths]]) => {
+            const row = document.createElement('div');
+            row.style.cssText = 'display:flex;justify-content:space-between;gap:16px;' + (id === this.id ? 'color:#ffd54f;' : '');
+            const name = document.createElement('span');
+            name.textContent = this.names.get(id);
+            const kd = document.createElement('span');
+            kd.textContent = `${kills} / ${deaths}`;
+            row.append(name, kd);
+            this.scoreboardEl.appendChild(row);
+        });
+    }
+
+    FlashHitmarker(){
+        this.hitmarkerEl.style.opacity = 1;
+        clearTimeout(this.hitmarkerTimer);
+        this.hitmarkerTimer = setTimeout(() => { this.hitmarkerEl.style.opacity = 0; }, 120);
+    }
+
+    FlashDamage(){
+        this.damageEl.style.opacity = 1;
+        clearTimeout(this.damageTimer);
+        this.damageTimer = setTimeout(() => { this.damageEl.style.opacity = 0; }, 150);
+    }
+}

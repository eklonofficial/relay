diff --git a/src/entities/RemotePlayer/RemotePlayer.js b/src/entities/RemotePlayer/RemotePlayer.js
new file mode 100644
index 0000000..f69eebb
--- /dev/null
+++ b/src/entities/RemotePlayer/RemotePlayer.js
@@ -0,0 +1,152 @@
+import * as THREE from 'three'
+import Component from '../../Component'
+
+// Another online player, drawn with the mutant model. Hitboxes come from CharacterCollision,
+// so the local Weapon's raycast reports hits on it like it does for the AI mutant.
+export default class RemotePlayer extends Component{
+    constructor({id, playerName, model, clips, scene, shotBuffer, listener, network}){
+        super();
+        this.name = 'RemotePlayer';
+        this.remoteId = id;
+        this.playerName = playerName;
+        this.model = model;
+        this.clips = clips;
+        this.scene = scene;
+        this.shotBuffer = shotBuffer;
+        this.listener = listener;
+        this.network = network;
+
+        this.targetPos = new THREE.Vector3();
+        this.targetRot = new THREE.Quaternion();
+        this.yAxis = new THREE.Vector3(0, 1, 0);
+        this.anim = 0;
+        this.dead = false;
+        this.hasTarget = false;
+        this.actions = {};
+        this.current = null;
+    }
+
+    Initialize(){
+        const model = this.model;
+        model.scale.setScalar(0.01);
+        model.position.copy(this.parent.Position);
+
+        this.mixer = new THREE.AnimationMixer(model);
+        ['idle', 'run', 'die'].forEach(key => {
+            this.actions[key] = this.mixer.clipAction(this.clips[key]);
+        });
+        this.actions.die.setLoop(THREE.LoopOnce);
+        this.actions.die.clampWhenFinished = true;
+
+        model.traverse(child => {
+            if(!child.isSkinnedMesh){
+                return;
+            }
+            child.frustumCulled = false;
+            child.castShadow = true;
+            child.receiveShadow = true;
+            this.rootBone = child.skeleton.bones.find(bone => bone.name == 'MutantHips');
+            this.rootBone.refPos = this.rootBone.position.clone();
+        });
+
+        this.tag = this.CreateNameTag(this.playerName);
+        this.scene.add(this.tag);
+
+        this.sound = new THREE.PositionalAudio(this.listener);
+        this.sound.setBuffer(this.shotBuffer);
+        this.sound.setRefDistance(4);
+        model.add(this.sound);
+
+        this.scene.add(model);
+        this.Play('idle');
+
+        this.parent.RegisterEventHandler(this.TakeHit, 'hit');
+    }
+
+    CreateNameTag(text){
+        const canvas = document.createElement('canvas');
+        canvas.width = 256;
+        canvas.height = 64;
+        const ctx = canvas.getContext('2d');
+        ctx.font = 'bold 32px sans-serif';
+        ctx.textAlign = 'center';
+        ctx.textBaseline = 'middle';
+        ctx.fillStyle = 'rgba(0,0,0,0.5)';
+        const w = Math.min(250, ctx.measureText(text).width + 24);
+        ctx.fillRect((256 - w) / 2, 8, w, 48);
+        ctx.fillStyle = '#ffffff';
+        ctx.fillText(text, 128, 32);
+        const material = new THREE.SpriteMaterial({map: new THREE.CanvasTexture(canvas), depthTest: true, transparent: true});
+        const sprite = new THREE.Sprite(material);
+        sprite.scale.set(1.2, 0.3, 1);
+        return sprite;
+    }
+
+    SetTarget(x, y, z, yaw, anim, dead){
+        this.targetPos.set(x, y, z);
+        // The model faces +Z; the player's camera faces -Z at yaw 0.
+        this.targetRot.setFromAxisAngle(this.yAxis, yaw + Math.PI);
+        // First sighting or a respawn across the map: jump there instead of sliding.
+        if(!this.hasTarget || this.model.position.distanceToSquared(this.targetPos) > 25.0){
+            this.model.position.copy(this.targetPos);
+            this.model.quaternion.copy(this.targetRot);
+            this.hasTarget = true;
+        }
+        this.anim = anim;
+        this.dead = dead;
+    }
+
+    Play(name){
+        if(this.current === name){
+            return;
+        }
+        const next = this.actions[name];
+        next.reset().play();
+        if(this.current){
+            next.crossFadeFrom(this.actions[this.current], 0.2, true);
+        }
+        this.current = name;
+    }
+
+    PlayShot(){
+        if(this.dead){
+            return;
+        }
+        this.sound.isPlaying && this.sound.stop();
+        this.sound.play();
+    }
+
+    TakeHit = () => {
+        if(!this.dead){
+            this.network.SendHit(this.remoteId);
+        }
+    }
+
+    Update(t){
+        this.mixer.update(t);
+        // The run clip has root motion; position comes from the network instead.
+        this.rootBone.position.x = this.rootBone.refPos.x;
+        this.rootBone.position.z = this.rootBone.refPos.z;
+
+        const k = 1.0 - Math.exp(-12.0 * t);
+        this.model.position.lerp(this.targetPos, k);
+        this.model.quaternion.slerp(this.targetRot, k);
+
+        this.Play(this.dead ? 'die' : (this.anim === 1 ? 'run' : 'idle'));
+
+        this.tag.position.copy(this.model.position);
+        this.tag.position.y += 2.2;
+        this.tag.visible = !this.dead;
+
+        this.parent.SetPosition(this.model.position);
+        this.parent.SetRotation(this.model.quaternion);
+    }
+
+    Destroy(){
+        this.sound.isPlaying && this.sound.stop();
+        this.scene.remove(this.model);
+        this.scene.remove(this.tag);
+        this.tag.material.map.dispose();
+        this.tag.material.dispose();
+    }
+}
